
# Copy to .env and replace the credential placeholders with sandbox credentials.
BASE_URL=https://sandbox-app.brighthr.com
BRIGHTHR_EMAIL=your-test-account@example.com
BRIGHTHR_PASSWORD=replace-with-your-test-account-password
HEADLESS=true
TIMEOUT_MS=120000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
EMPLOYEE_DATA_FILE=data/employees.xlsx
# Keep registration emails disabled for test employees.
SEND_REGISTRATION_EMAIL=false
