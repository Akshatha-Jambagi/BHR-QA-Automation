{
  "name": "brighthr-playwright-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight BrightHR UI automation using Playwright, TypeScript and Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
